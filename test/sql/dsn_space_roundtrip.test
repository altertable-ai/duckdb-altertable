# name: test/sql/dsn_space_roundtrip.test
# description: DSN values containing spaces survive secret expansion
# group: [sql]

require altertable

statement ok
CREATE SECRET __dsn_space_roundtrip (
    TYPE altertable,
    HOST 'bad host',
    PORT '1',
    USER 'u',
    PASSWORD 'p',
    SSL 'false'
)

# ATTACH validates connectivity immediately; the connection error must retain
# the space in the host value after secret expansion.
statement error
ATTACH '' AS __dsn_space_roundtrip_db (TYPE ALTERTABLE, SECRET __dsn_space_roundtrip)
----
bad host

statement ok
DROP SECRET __dsn_space_roundtrip
