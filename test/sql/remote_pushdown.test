# name: test/sql/remote_pushdown.test
# description: Test DuckDB RemotePushdownOptimizer integration for attached Altertable catalogs
# group: [sql]

require altertable

require-env ALTERTABLE_TEST_HOST

require-env ALTERTABLE_TEST_PORT

require-env ALTERTABLE_TEST_USER

require-env ALTERTABLE_TEST_PASSWORD

require-env ALTERTABLE_TEST_SSL

statement ok
ATTACH 'host={ALTERTABLE_TEST_HOST} port={ALTERTABLE_TEST_PORT} user={ALTERTABLE_TEST_USER} password={ALTERTABLE_TEST_PASSWORD} ssl={ALTERTABLE_TEST_SSL}' AS remote_pushdown_db (TYPE ALTERTABLE)

statement ok
CALL altertable_execute('remote_pushdown_db', 'DROP TABLE IF EXISTS __remote_pushdown_orders')

statement ok
CALL altertable_execute('remote_pushdown_db', 'DROP TABLE IF EXISTS __remote_pushdown_products')

statement ok
CALL altertable_execute('remote_pushdown_db', 'CREATE TABLE __remote_pushdown_orders (order_id INTEGER, product_id INTEGER, quantity INTEGER)')

statement ok
CALL altertable_execute('remote_pushdown_db', 'CREATE TABLE __remote_pushdown_products (product_id INTEGER, name VARCHAR, price DOUBLE)')

statement ok
CALL altertable_execute('remote_pushdown_db', 'INSERT INTO __remote_pushdown_orders VALUES (100, 1, 5), (101, 3, 2), (102, 1, 3), (103, 2, 1)')

statement ok
CALL altertable_execute('remote_pushdown_db', 'INSERT INTO __remote_pushdown_products VALUES (1, ''Product A'', 19.99), (2, ''Product B'', 29.50), (3, ''Product C'', 15.00)')

query TI
SELECT p.name, SUM(o.quantity) AS total_quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN remote_pushdown_db.main.__remote_pushdown_products p ON o.product_id = p.product_id
GROUP BY p.name
ORDER BY p.name
----
Product A	8
Product B	1
Product C	2

query II
EXPLAIN SELECT p.name, SUM(o.quantity) AS total_quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN remote_pushdown_db.main.__remote_pushdown_products p ON o.product_id = p.product_id
GROUP BY p.name
ORDER BY p.name
----
physical_plan	<REGEX>:.*ALTERTABLE_SCAN.*

query II
EXPLAIN SELECT p.name, SUM(o.quantity) AS total_quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN remote_pushdown_db.main.__remote_pushdown_products p ON o.product_id = p.product_id
GROUP BY p.name
ORDER BY p.name
----
physical_plan	<REGEX>:.*Query:.*

query II
EXPLAIN SELECT p.name, SUM(o.quantity) AS total_quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN remote_pushdown_db.main.__remote_pushdown_products p ON o.product_id = p.product_id
GROUP BY p.name
ORDER BY p.name
----
physical_plan	<!REGEX>:.*(HASH_JOIN|HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|UNGROUPED_AGGREGATE|PARTITIONED_AGGREGATE).*

statement ok
USE remote_pushdown_db

query I
SELECT COUNT(*) FROM __remote_pushdown_orders WHERE quantity > 1
----
3

query II
EXPLAIN SELECT COUNT(*) FROM __remote_pushdown_orders WHERE quantity > 1
----
physical_plan	<REGEX>:.*Query:.*

statement ok
USE memory

query II
SELECT * FROM (
	SELECT o.product_id, p.product_id
	FROM remote_pushdown_db.main.__remote_pushdown_orders o
	JOIN remote_pushdown_db.main.__remote_pushdown_products p ON o.product_id = p.product_id
	ORDER BY o.product_id
	LIMIT 1
)
----
1	1

statement ok
CREATE TABLE __local_remote_pushdown_filter(product_id INTEGER)

statement ok
INSERT INTO __local_remote_pushdown_filter VALUES (1)

query II
SELECT o.order_id, o.quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN __local_remote_pushdown_filter l ON o.product_id = l.product_id
ORDER BY o.order_id
----
100	5
102	3

query II
EXPLAIN SELECT o.order_id, o.quantity
FROM remote_pushdown_db.main.__remote_pushdown_orders o
JOIN __local_remote_pushdown_filter l ON o.product_id = l.product_id
ORDER BY o.order_id
----
physical_plan	<REGEX>:.*HASH_JOIN.*

statement ok
UPDATE remote_pushdown_db.main.__remote_pushdown_products SET price = 20.5 WHERE product_id = 1

query R
SELECT price FROM remote_pushdown_db.main.__remote_pushdown_products WHERE product_id = 1
----
20.5

statement ok
DELETE FROM remote_pushdown_db.main.__remote_pushdown_orders WHERE order_id = 103

query I
SELECT COUNT(*) FROM remote_pushdown_db.main.__remote_pushdown_orders
----
3

statement ok
DROP TABLE __local_remote_pushdown_filter

statement ok
CALL altertable_execute('remote_pushdown_db', 'DROP TABLE __remote_pushdown_orders')

statement ok
CALL altertable_execute('remote_pushdown_db', 'DROP TABLE __remote_pushdown_products')

statement ok
DETACH remote_pushdown_db
