# name: test/sql/attach_error_handling.test
# description: ATTACH validates connectivity immediately and fails for unreachable hosts
# group: [sql]

require altertable

# Unreachable host: ATTACH itself must fail (eager validation)
statement error
ATTACH 'host=127.0.0.1 port=1 user=test password=test ssl=false' AS test_db (TYPE ALTERTABLE)
----
Failed to connect
