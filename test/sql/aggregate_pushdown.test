# name: test/sql/aggregate_pushdown.test
# description: Test which aggregate queries are pushed to Altertable vs executed locally
# group: [sql]

require altertable

require-env ALTERTABLE_TEST_HOST

require-env ALTERTABLE_TEST_PORT

require-env ALTERTABLE_TEST_USER

require-env ALTERTABLE_TEST_PASSWORD

require-env ALTERTABLE_TEST_SSL

statement ok
ATTACH 'host=${ALTERTABLE_TEST_HOST} port=${ALTERTABLE_TEST_PORT} user=${ALTERTABLE_TEST_USER} password=${ALTERTABLE_TEST_PASSWORD} ssl=${ALTERTABLE_TEST_SSL}' AS agg_pushdown_db (TYPE ALTERTABLE)

statement ok
CALL altertable_execute('agg_pushdown_db', 'DROP TABLE IF EXISTS __sqllogic_widget_metrics')

statement ok
CALL altertable_execute('agg_pushdown_db', 'CREATE TABLE __sqllogic_widget_metrics (region_id INTEGER, device_id INTEGER, event_date DATE, weight DOUBLE, score_a DOUBLE, score_b DOUBLE, is_synthetic BOOLEAN, is_holdout BOOLEAN)')

statement ok
CALL altertable_execute('agg_pushdown_db', 'INSERT INTO __sqllogic_widget_metrics VALUES (1, 10, DATE ''2024-06-01'', 0.5, 0.1, 0.2, false, false), (1, 11, DATE ''2024-06-02'', 0.6, 0.3, 0.4, false, false), (2, 20, DATE ''2024-06-01'', 0.7, 0.5, 0.6, false, false)')

# ---------------------------------------------------------------------------
# Simple aggregates: full query pushed to a single remote ALTERTABLE_SCAN
# ---------------------------------------------------------------------------

query IIRI
SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false AND is_holdout = false
GROUP BY region_id
ORDER BY region_id
----
1	2	0.55	2
2	1	0.7	1

query II
EXPLAIN SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false AND is_holdout = false
GROUP BY region_id
ORDER BY region_id
----
physical_plan	<REGEX>:.*ALTERTABLE_SCAN.*

query II
EXPLAIN SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false AND is_holdout = false
GROUP BY region_id
ORDER BY region_id
----
physical_plan	<REGEX>:.*Query:.*

query II
EXPLAIN SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false AND is_holdout = false
GROUP BY region_id
ORDER BY region_id
----
physical_plan	<!REGEX>:.*(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|UNGROUPED_AGGREGATE|PARTITIONED_AGGREGATE).*

# Pushed-down results must match the equivalent remote altertable_query
query I
SELECT COUNT(*) FROM (
    (SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     WHERE is_synthetic = false AND is_holdout = false
     GROUP BY region_id
     ORDER BY region_id)
    EXCEPT
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a) FROM main.__sqllogic_widget_metrics WHERE is_synthetic = false AND is_holdout = false GROUP BY region_id ORDER BY region_id'))
    UNION ALL
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a) FROM main.__sqllogic_widget_metrics WHERE is_synthetic = false AND is_holdout = false GROUP BY region_id ORDER BY region_id'))
    EXCEPT
    (SELECT region_id, COUNT(*), AVG(weight), COUNT(score_a)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     WHERE is_synthetic = false AND is_holdout = false
     GROUP BY region_id
     ORDER BY region_id)
)
----
0

query II
EXPLAIN SELECT approx_quantile(score_a, 0.5) FROM agg_pushdown_db.main.__sqllogic_widget_metrics GROUP BY region_id
----
physical_plan	<REGEX>:.*ALTERTABLE_SCAN.*

query II
EXPLAIN SELECT approx_quantile(score_a, 0.5) FROM agg_pushdown_db.main.__sqllogic_widget_metrics GROUP BY region_id
----
physical_plan	<!REGEX>:.*(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|UNGROUPED_AGGREGATE|PARTITIONED_AGGREGATE).*

query I
SELECT COUNT(*) FROM (
    (SELECT approx_quantile(score_a, 0.5)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     GROUP BY region_id)
    EXCEPT
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT approx_quantile(score_a, 0.5) FROM main.__sqllogic_widget_metrics GROUP BY region_id'))
    UNION ALL
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT approx_quantile(score_a, 0.5) FROM main.__sqllogic_widget_metrics GROUP BY region_id'))
    EXCEPT
    (SELECT approx_quantile(score_a, 0.5)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     GROUP BY region_id)
)
----
0

# ---------------------------------------------------------------------------
# DISTINCT aggregates: full query pushed remotely (no local group/agg operators)
# ---------------------------------------------------------------------------

query II
EXPLAIN SELECT region_id, COUNT(DISTINCT device_id) FROM agg_pushdown_db.main.__sqllogic_widget_metrics GROUP BY region_id
----
physical_plan	<REGEX>:.*ALTERTABLE_SCAN.*

query II
EXPLAIN SELECT region_id, COUNT(DISTINCT device_id) FROM agg_pushdown_db.main.__sqllogic_widget_metrics GROUP BY region_id
----
physical_plan	<REGEX>:.*Query:.*

query II
EXPLAIN SELECT region_id, COUNT(DISTINCT device_id) FROM agg_pushdown_db.main.__sqllogic_widget_metrics GROUP BY region_id
----
physical_plan	<!REGEX>:.*(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|UNGROUPED_AGGREGATE|PARTITIONED_AGGREGATE).*

query I
SELECT COUNT(*) FROM (
    (SELECT region_id, COUNT(DISTINCT device_id)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     GROUP BY region_id
     ORDER BY region_id)
    EXCEPT
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(DISTINCT device_id) FROM main.__sqllogic_widget_metrics GROUP BY region_id ORDER BY region_id'))
    UNION ALL
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(DISTINCT device_id) FROM main.__sqllogic_widget_metrics GROUP BY region_id ORDER BY region_id'))
    EXCEPT
    (SELECT region_id, COUNT(DISTINCT device_id)
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     GROUP BY region_id
     ORDER BY region_id)
)
----
0

# ---------------------------------------------------------------------------
# Mixed aggregate dashboard query: single remote scan, no local aggregation
# ---------------------------------------------------------------------------

query II
EXPLAIN
SELECT
    region_id,
    COUNT(*) AS row_count,
    COUNT(DISTINCT device_id) AS device_count,
    COUNT(DISTINCT event_date) AS distinct_days,
    AVG(weight) AS avg_weight,
    AVG(score_a) AS score_a_mean,
    approx_quantile(score_a, 0.50) AS score_a_q50,
    COUNT(score_a) AS score_a_n,
    AVG(score_b) AS score_b_mean,
    approx_quantile(score_b, 0.50) AS score_b_q50,
    COUNT(score_b) AS score_b_n
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false
  AND is_holdout = false
  AND event_date BETWEEN DATE '2024-06-01' AND DATE '2024-06-30'
GROUP BY region_id
----
physical_plan	<REGEX>:.*ALTERTABLE_SCAN.*

query II
EXPLAIN
SELECT
    region_id,
    COUNT(*) AS row_count,
    COUNT(DISTINCT device_id) AS device_count,
    COUNT(DISTINCT event_date) AS distinct_days,
    AVG(weight) AS avg_weight,
    AVG(score_a) AS score_a_mean,
    approx_quantile(score_a, 0.50) AS score_a_q50,
    COUNT(score_a) AS score_a_n,
    AVG(score_b) AS score_b_mean,
    approx_quantile(score_b, 0.50) AS score_b_q50,
    COUNT(score_b) AS score_b_n
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false
  AND is_holdout = false
  AND event_date BETWEEN DATE '2024-06-01' AND DATE '2024-06-30'
GROUP BY region_id
----
physical_plan	<REGEX>:.*Query:.*

query II
EXPLAIN
SELECT
    region_id,
    COUNT(*) AS row_count,
    COUNT(DISTINCT device_id) AS device_count,
    COUNT(DISTINCT event_date) AS distinct_days,
    AVG(weight) AS avg_weight,
    AVG(score_a) AS score_a_mean,
    approx_quantile(score_a, 0.50) AS score_a_q50,
    COUNT(score_a) AS score_a_n,
    AVG(score_b) AS score_b_mean,
    approx_quantile(score_b, 0.50) AS score_b_q50,
    COUNT(score_b) AS score_b_n
FROM agg_pushdown_db.main.__sqllogic_widget_metrics
WHERE is_synthetic = false
  AND is_holdout = false
  AND event_date BETWEEN DATE '2024-06-01' AND DATE '2024-06-30'
GROUP BY region_id
----
physical_plan	<!REGEX>:.*(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|UNGROUPED_AGGREGATE|PARTITIONED_AGGREGATE).*

query I
SELECT COUNT(*) FROM (
    (SELECT
        region_id,
        COUNT(*) AS row_count,
        COUNT(DISTINCT device_id) AS device_count,
        COUNT(DISTINCT event_date) AS distinct_days,
        AVG(weight) AS avg_weight,
        AVG(score_a) AS score_a_mean,
        approx_quantile(score_a, 0.50) AS score_a_q50,
        COUNT(score_a) AS score_a_n,
        AVG(score_b) AS score_b_mean,
        approx_quantile(score_b, 0.50) AS score_b_q50,
        COUNT(score_b) AS score_b_n
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     WHERE is_synthetic = false
       AND is_holdout = false
       AND event_date BETWEEN DATE '2024-06-01' AND DATE '2024-06-30'
     GROUP BY region_id
     ORDER BY region_id)
    EXCEPT
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(*) AS row_count, COUNT(DISTINCT device_id) AS device_count, COUNT(DISTINCT event_date) AS distinct_days, AVG(weight) AS avg_weight, AVG(score_a) AS score_a_mean, approx_quantile(score_a, 0.50) AS score_a_q50, COUNT(score_a) AS score_a_n, AVG(score_b) AS score_b_mean, approx_quantile(score_b, 0.50) AS score_b_q50, COUNT(score_b) AS score_b_n FROM main.__sqllogic_widget_metrics WHERE is_synthetic = false AND is_holdout = false AND event_date BETWEEN DATE ''2024-06-01'' AND DATE ''2024-06-30'' GROUP BY region_id ORDER BY region_id'))
    UNION ALL
    (SELECT * FROM altertable_query(
        'agg_pushdown_db',
        'SELECT region_id, COUNT(*) AS row_count, COUNT(DISTINCT device_id) AS device_count, COUNT(DISTINCT event_date) AS distinct_days, AVG(weight) AS avg_weight, AVG(score_a) AS score_a_mean, approx_quantile(score_a, 0.50) AS score_a_q50, COUNT(score_a) AS score_a_n, AVG(score_b) AS score_b_mean, approx_quantile(score_b, 0.50) AS score_b_q50, COUNT(score_b) AS score_b_n FROM main.__sqllogic_widget_metrics WHERE is_synthetic = false AND is_holdout = false AND event_date BETWEEN DATE ''2024-06-01'' AND DATE ''2024-06-30'' GROUP BY region_id ORDER BY region_id'))
    EXCEPT
    (SELECT
        region_id,
        COUNT(*) AS row_count,
        COUNT(DISTINCT device_id) AS device_count,
        COUNT(DISTINCT event_date) AS distinct_days,
        AVG(weight) AS avg_weight,
        AVG(score_a) AS score_a_mean,
        approx_quantile(score_a, 0.50) AS score_a_q50,
        COUNT(score_a) AS score_a_n,
        AVG(score_b) AS score_b_mean,
        approx_quantile(score_b, 0.50) AS score_b_q50,
        COUNT(score_b) AS score_b_n
     FROM agg_pushdown_db.main.__sqllogic_widget_metrics
     WHERE is_synthetic = false
       AND is_holdout = false
       AND event_date BETWEEN DATE '2024-06-01' AND DATE '2024-06-30'
     GROUP BY region_id
     ORDER BY region_id)
)
----
0

statement ok
CALL altertable_execute('agg_pushdown_db', 'DROP TABLE __sqllogic_widget_metrics')

statement ok
DETACH agg_pushdown_db
